# Bot Service Configuration
BOT_HOST=0.0.0.0
BOT_PORT=8080
BOT_URL=http://localhost:8080

# LLM Provider Configuration
# Primary: Gemini (Free Tier) — set GEMINI_API_KEY from https://aistudio.google.com/
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Bot Metadata
TEAM_NAME=Team Vera AI Engine
CONTACT_EMAIL=gaganpreet.singh.ug23@nsut.ac.in